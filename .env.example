# Copia este archivo a ".env" (en la raíz del proyecto). Todo es opcional.

# Si lo defines, la API exige el header "X-API-Key: <valor>" en /api/*  (excepto /api/health).
# Úsalo al publicar el dashboard por un túnel (Cloudflare) para que nadie más use tu equipo.
API_KEY=

# Asistente Ada (modelo de lenguaje, opcional): dirección y clave que le da quien corre el servidor de Ada
# (scripts/start_ada_server.ps1). Sin esto, el botón del asistente dice «no configurado» y el resto del panel funciona igual.
ADA_REMOTE_URL=
ADA_REMOTE_KEY=

# Motor de cálculo. Vacío = «auto»: usa la Ada de ESTE equipo (carpeta ..\Ada) y, si no está, la API de Ada con las dos líneas de arriba
# (los cálculos los hace entonces el PC que corre Ada, que debe estar encendido). «local» o «remote» fuerzan una de las dos.
ADA_ENGINE=

# Trabajar sin Ada, con el motor Python local (el panel lo rotula «Motor: Python local (sin Ada)»). «Abrir CodePredict» ya lo declara solo en un equipo
# que no tiene Ada ni su API; aquí sirve para forzarlo a mano. Vacío = lo normal (manda Ada).
CODEPREDICT_MOTOR=

# Solo para el frontend en desarrollo (npm run dev): clave que el navegador envía a la API.
# Pónla también en frontend/.env.local como VITE_API_KEY=<mismo valor>
